function startSession(){
  if(S.busy)return;S.busy=true;
  var st=S.settings;
  api('/sessions',{method:'POST',body:JSON.stringify({
    model:modelOf(st),start_capital:Number(st.total_capital),total_trades:Number(st.total_trades),
    expected_wins:Number(st.expected_wins),loss_limit:Number(st.loss_limit),payout_pct:Number(st.payout_pct),
    base_stake_pct:Number(st.base_stake_pct),target_profit_pct:Number(st.target_profit_pct),
    max_stake_pct:Number(st.max_stake_pct),ladder:JSON.stringify(ladderOf(st))})})
  .then(function(){return loadSessions();}).then(loadActive).then(function(){S.busy=false;render();})
  .catch(function(e){S.busy=false;toast(e.message);});
}

function record(win){
  if(S.busy||!S.active)return;S.busy=true;
  var s=S.active,t=S.trades,nx=stakeFor(s,t),cap=curCap(s,t);
  var after=win?cap+nx.amount*(Number(s.payout_pct)/100):cap-nx.amount;
  api('/sessions/'+s.id+'/trades',{method:'POST',body:JSON.stringify({
    seq:t.length+1,stake_pct:nx.pct,stake_amount:nx.amount,
    result:win?'win':'loss',capital_after:after})})
  .then(function(){return loadSessions();}).then(loadActive).then(function(){
    var r=stopReason(S.active,S.trades);
    S.busy=false;
    if(r)endSession(r);else render();
  }).catch(function(e){S.busy=false;toast(e.message);});
}

function endManual(){endSession('Ended manually');}

function endSession(reason){
  if(!S.active)return;
  var cap=curCap(S.active,S.trades);
  api('/sessions/'+S.active.id,{method:'PATCH',body:JSON.stringify({
    status:'ended',end_capital:cap,ended_at:new Date().toISOString(),note:reason})})
  .then(function(){return loadSessions();}).then(loadActive).then(function(){render();toast(reason+' Saved to journal.');})
  .catch(function(e){toast(e.message);});
}

