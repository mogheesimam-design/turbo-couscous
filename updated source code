<body>
<div id="app"><div class="empty" style="padding-top:70px">Loading...</div></div>
<nav id="nav"></nav>
<button id="installBtn" class="btn primary" style="display:none;position:fixed;left:50%;transform:translateX(-50%);bottom:92px;z-index:60;padding:12px 24px;font-size:12px;box-shadow:0 14px 34px rgba(34,197,94,.45)" onclick="doInstall()">Install app</button>
<script>
var S={settings:null,sessions:[],view:'session',active:null,trades:[],open:{},busy:false,user:null,adminUsers:null,bot:null};

function esc(s){return String(s==null?'':s).split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;').split('"').join('&quot;');}
function money(n){return (Math.round((n||0)*100)/100).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});}
function num(n){return Number(n||0).toLocaleString();}
function api(p,o){o=o||{};o.credentials='same-origin';o.headers={'Content-Type':'application/json'};return fetch('/api'+p,o).then(function(r){return r.json().then(function(j){if(!r.ok)throw new Error((j&&j.error)||('HTTP '+r.status));return j;});});}
function toast(m){var d=document.createElement('div');d.className='toast';d.textContent=m;document.body.appendChild(d);setTimeout(function(){d.remove();},2400);}

function modelOf(o){return o.model||'tatura';}
function ladderOf(o){try{var v=typeof o.ladder==='string'?JSON.parse(o.ladder):o.ladder;if(v&&v.length)return v.map(Number);}catch(e){}return [7,12,18,26,36,48];}
function curCap(s,t){return t.length?Number(t[t.length-1].capital_after):Number(s.start_capital);}
function tally(t){var w=0,l=0;for(var i=0;i<t.length;i++){if(t[i].result==='win')w++;else l++;}return {wins:w,losses:l};}
function streak(t){var n=0;for(var i=t.length-1;i>=0;i--){if(t[i].result==='loss')n++;else break;}return n;}
function targetAmt(s){return Number(s.start_capital)*Number(s.target_profit_pct||0)/100;}

function peakCap(s,t){
  var p=Number(s.start_capital);
  for(var i=0;i<t.length;i++){var c=Number(t[i].capital_after);if(c>p)p=c;}
  return p;
}

function stakeFor(s,t){
  var C=curCap(s,t),R=Number(s.payout_pct)/100,base=Number(s.base_stake_pct||8);
  var m=modelOf(s),amt=0,mode='base',b=C*base/100,peak=peakCap(s,t);
  if(m==='tatura'){
    if(C>=peak){amt=b;mode='base';}
    else{
      var gap=peak-C;
      amt=(R>0)?gap/R:gap;
      if(amt<b)amt=b;
      mode='recovery';
    }
  }else if(m==='masaniello'){
    amt=b;mode='flat';
  }else{
    var Ld=ladderOf(s);amt=C*Ld[Math.min(streak(t),Ld.length-1)]/100;mode='ladder';
  }
  if(!isFinite(amt)||amt<0)amt=0;
  var cap=C*Number(s.max_stake_pct||100)/100,capped=amt>cap;
  if(capped)amt=cap;
  return {amount:amt,pct:C>0?amt/C*100:0,capped:capped,mode:mode,peak:peak};
}
function stopReason(s,t){
  var x=tally(t),cap=curCap(s,t),pnl=cap-Number(s.start_capital),lim=Number(s.loss_limit||3);
  if(x.losses>=lim)return 'Loss limit hit - '+x.losses+' losses in this session.';
  if(t.length>=Number(s.total_trades))return 'Trade target reached - '+s.total_trades+' trades.';
  if(x.wins>=Number(s.expected_wins))return 'Win target reached - '+s.expected_wins+' wins.';
  if(cap<=0)return 'Capital exhausted.';
  if(modelOf(s)==='masaniello'&&pnl>=targetAmt(s))return 'Profit target reached.';
  return null;
}

function preview(o){
  var s={model:modelOf(o),start_capital:Number(o.total_capital||o.start_capital||0),total_trades:Number(o.total_trades||0),
    payout_pct:Number(o.payout_pct||0),target_profit_pct:Number(o.target_profit_pct||0),
    base_stake_pct:Number(o.base_stake_pct||8),max_stake_pct:Number(o.max_stake_pct||100),ladder:o.ladder};
  var t=[],out=[];
  for(var i=0;i<5;i++){var r=stakeFor(s,t);out.push(r);var cap=curCap(s,t);t.push({result:'loss',stake_amount:r.amount,capital_after:cap-r.amount});}
  return out;
}

function modelName(m){return m==='masaniello'?'Masaniello':(m==='ladder'?'Fixed ladder':'Tatura - peak recovery');}

function nav(){
  var it=[['session','Session'],['journal','Journal'],['portfolio','Portfolio'],['profile','Profile']];
  if(S.user&&S.user.role==='admin')it.push(['admin','Admin']);
  document.getElementById('nav').innerHTML=it.map(function(x){
    return '<a href="#'+x[0]+'" class="'+(S.view===x[0]?'on':'')+'">'+x[1]+'</a>';
  }).join('')+(S.user?'<a href="#" onclick="doLogout();return false;" style="float:right;opacity:.6">Sign out</a>':'');
}
function head(r){return '<div class="hdr"><div class="brand">Tatura <b>Model</b></div>'+(r||'')+'</div>';}

function render(){
  nav();
  var a=document.getElementById('app');
  if(S.view==='session')a.innerHTML=vSession();
  else if(S.view==='journal')a.innerHTML=vJournal();
  else if(S.view==='portfolio')a.innerHTML=vPortfolio();
  else if(S.view==='admin')a.innerHTML=vAdmin();
  else a.innerHTML=vProfile();
  window.scrollTo(0,0);
}
function vSession(){
  if(!S.active){
    var st=S.settings||{},pv=preview(st);
    return head('<span class="pill">idle</span>')+
      '<div class="card"><h3>Ready to start</h3>'+
      '<div class="row"><span>Model</span><b>'+modelName(modelOf(st))+'</b></div>'+
      '<div class="row"><span>Total capital</span><b>'+money(st.total_capital)+'</b></div>'+
      '<div class="row"><span>Base stake</span><b>'+num(st.base_stake_pct)+'%</b></div>'+
      '<div class="row"><span>Total trades</span><b>'+num(st.total_trades)+'</b></div>'+
      '<div class="row"><span>Expected wins</span><b>'+num(st.expected_wins)+'</b></div>'+
      '<div class="row"><span>Loss limit</span><b>'+num(st.loss_limit)+' losses</b></div>'+
      '<div class="row"><span>Payout</span><b>'+num(st.payout_pct)+'%</b></div>'+
      '<div class="row"><span>Opening stakes</span><b>'+pv.map(function(p){return Math.round(p.pct)+'%';}).join(' / ')+'</b></div>'+
      '<div style="margin-top:18px"><button class="btn primary full" onclick="startSession()">Start session</button></div>'+
      '<div class="hint" style="text-align:center">Change these in Profile before starting.</div></div>';
  }
  var s=S.active,t=S.trades,x=tally(t),cap=curCap(s,t),nx=stakeFor(s,t);
  var pnl=cap-Number(s.start_capital),done=t.length,total=Number(s.total_trades);
  var below=cap<Number(s.start_capital),pv=preview(s);
  var lad=pv.map(function(p,i){return '<i class="'+(i===0?'on':'')+'">'+Math.round(p.pct)+'%</i>';}).join('');
  var prog=Math.min(100,done/total*100);
  var pill=nx.mode==='recovery'?'<span class="pill rec">recovery</span>':'<span class="pill live">live</span>';
  return head(pill)+
    '<div class="card"><div class="stage"><div class="lbl">Next trade stake</div>'+
    '<div class="big">'+Math.round(nx.pct)+'<small>%</small></div>'+
    '<div class="sub">approx <b>'+money(nx.amount)+'</b> of <b>'+money(cap)+'</b></div>'+
    '<div class="lad">'+lad+'</div>'+
    (nx.capped?'<div class="warn">Capped at '+num(s.max_stake_pct)+'% of capital</div>':'')+
    '</div><div class="acts">'+
    '<button class="btn win" onclick="record(1)">Win</button>'+
    '<button class="btn loss" onclick="record(0)">Loss</button></div>'+
    '<div class="track"><i style="width:'+prog+'%"></i></div>'+
    '<div class="sub" style="text-align:center">'+(pnl>=0?'+':'')+money(pnl)+' &middot; '+done+'/'+total+' trades</div></div>'+
    '<div class="g2">'+
    '<div class="st"><div class="k">Capital</div><div class="v '+(pnl>=0?'win':'loss')+'">'+money(cap)+'</div></div>'+
    '<div class="st"><div class="k">P / L</div><div class="v '+(pnl>=0?'win':'loss')+'">'+(pnl>=0?'+':'')+money(pnl)+'</div></div>'+
    '<div class="st"><div class="k">Wins</div><div class="v win">'+x.wins+' / '+s.expected_wins+'</div></div>'+
    '<div class="st"><div class="k">Losses</div><div class="v loss">'+x.losses+' / '+s.loss_limit+'</div></div></div>'+
    (below?'<div class="card" style="padding:14px 18px"><div class="hint" style="margin:0">Below starting capital - recovery staking active. A win back to '+money(s.start_capital)+' resets the stake to '+num(s.base_stake_pct)+'%.</div></div>':'')+
    '<div class="card"><h3>Session log</h3>'+
    (t.length?t.slice().reverse().map(function(r){
      return '<div class="tr"><span class="n">'+r.seq+'</span><span class="p">'+Math.round(r.stake_pct)+'% &middot; '+money(r.stake_amount)+'</span><span class="tag '+r.result+'">'+r.result+'</span></div>';
    }).join(''):'<div class="empty">No trades yet.</div>')+
    '<div style="margin-top:16px"><button class="btn ghost full" onclick="endManual()">End session</button></div></div>';
}

function vJournal(){
  var list=S.sessions.slice().sort(function(a,b){return b.id-a.id;});
  if(!list.length)return head('')+'<div class="card"><div class="empty">No sessions yet.<br>Start one from the Session tab.</div></div>';
  return head('<span class="pill">'+list.length+' sessions</span>')+list.map(function(s){
    var open=!!S.open[s.id];
    var st=Number(s.start_capital),en=s.end_capital==null?st:Number(s.end_capital),p=en-st;
    var cls=s.status==='active'?'open':(p>=0?'win':'loss');
    var lab=s.status==='active'?'open':(p>=0?'profit':'loss');
    var d=new Date(s.started_at);
    return '<div class="sess"><div class="sh" onclick="toggle('+s.id+')">'+
      '<div><div class="d">'+d.toLocaleDateString()+' '+d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+'</div>'+
      '<div class="m">'+s.wins+'W / '+s.losses+'L &middot; '+(s.wins+s.losses)+' trades</div></div>'+
      '<div><div class="p">'+(p>=0?'+':'')+money(p)+'</div><div style="text-align:right;margin-top:3px"><span class="tag '+cls+'">'+lab+'</span></div></div>'+
      '</div>'+(open?'<div class="sb" id="sb-'+s.id+'">'+body(s)+'</div>':'')+'</div>';
  }).join('');
}

function body(s){
  var st=Number(s.start_capital),en=s.end_capital==null?st:Number(s.end_capital);
  return '<div class="row"><span>Capital in</span><b>'+money(st)+'</b></div>'+
    '<div class="row"><span>Capital out</span><b>'+money(en)+'</b></div>'+
    '<div class="row"><span>Model</span><b>'+modelName(modelOf(s))+'</b></div>'+
    '<div class="row"><span>Base stake</span><b>'+num(s.base_stake_pct)+'%</b></div>'+
    '<div class="row"><span>Loss limit</span><b>'+s.loss_limit+' losses</b></div>'+
    (s.note?'<div class="row"><span>Reason</span><b style="font-weight:400;text-align:right;max-width:60%">'+esc(s.note)+'</b></div>':'')+
    '<div style="display:flex;gap:8px;margin-top:14px">'+
    '<button class="btn ghost" style="flex:1" onclick="editSession('+s.id+')">Edit</button>'+
