.btn.ghost{background:rgba(255,255,255,.05);border:1px solid var(--line2);color:var(--txt);font-size:12px;padding:14px;letter-spacing:.1em}
.btn.primary{background:linear-gradient(135deg,var(--green),var(--green2));color:#04120b;box-shadow:0 12px 30px rgba(34,197,94,.35),inset 0 1px 0 rgba(255,255,255,.3)}
.btn.full{width:100%}
.track{height:7px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden;margin-top:18px;border:1px solid rgba(255,255,255,.05)}
.track i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--green2),var(--green),var(--gold));transition:width .45s ease}
.lad{display:flex;gap:6px;margin-top:14px;flex-wrap:wrap;justify-content:center}
