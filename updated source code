.btn{border:0;border-radius:16px;padding:20px 12px;font-size:14px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;color:#fff;font-family:inherit;transition:transform .12s,box-shadow .2s,filter .2s}
.btn:active{transform:scale(.97)}
.btn:hover{filter:brightness(1.07)}
