// ===== BOT: money management (same rules as the website) =====
function mmLadder(s){
  try{var v=typeof s.ladder==='string'?JSON.parse(s.ladder):s.ladder;if(v&&v.length)return v.map(Number);}catch(e){}
  return [7,12,18,26,36,48];
}
function mmCap(s,t){return t.length?Number(t[t.length-1].capital_after):Number(s.start_capital);}
function mmTally(t){var w=0,l=0;for(var i=0;i<t.length;i++){if(t[i].result==='win')w++;else l++;}return {wins:w,losses:l};}
function mmStreak(t){var n=0;for(var i=t.length-1;i>=0;i--){if(t[i].result==='loss')n++;else break;}return n;}
function mmPeak(s,t){var p=Number(s.start_capital);for(var i=0;i<t.length;i++){var c=Number(t[i].capital_after);if(c>p)p=c;}return p;}
function mmStake(s,t){
  var C=mmCap(s,t),R=Number(s.payout_pct)/100,base=Number(s.base_stake_pct||8);
  var m=s.model||'tatura',amt=0,b=C*base/100,peak=mmPeak(s,t);
  if(m==='tatura'){
    if(C>=peak){amt=b;}
    else{var gap=peak-C;amt=(R>0)?gap/R:gap;if(amt<b)amt=b;}
  }else if(m==='masaniello'){
    amt=b;
  }else{
    var L=mmLadder(s);amt=C*L[Math.min(mmStreak(t),L.length-1)]/100;
  }
  if(!isFinite(amt)||amt<0)amt=0;
  var cap=C*Number(s.max_stake_pct||100)/100;
  if(amt>cap)amt=cap;
  return {amount:amt,pct:C>0?amt/C*100:0,capital:C};
}
function mmStop(s,t){
  var x=mmTally(t),cap=mmCap(s,t),pnl=cap-Number(s.start_capital),lim=Number(s.loss_limit||3);
  if(x.losses>=lim)return 'Loss limit hit - '+x.losses+' losses in this session.';
  if(t.length>=Number(s.total_trades))return 'Trade target reached - '+s.total_trades+' trades.';
  if(x.wins>=Number(s.expected_wins))return 'Win target reached - '+s.expected_wins+' wins.';
  if(cap<=0)return 'Capital exhausted.';
  if((s.model||'tatura')==='masaniello'&&pnl>=Number(s.start_capital)*Number(s.target_profit_pct||0)/100)return 'Profit target reached.';
  return null;
}

