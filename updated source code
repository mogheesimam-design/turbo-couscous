  if (!tok || String(tok).length < 20) return false;
  return (req.headers.get('Authorization') || '') === 'Bearer ' + tok;
}
async function botUser(db, url) {
  const name = (url.searchParams.get('user') || '').trim().toLowerCase();
  if (name) return await db.prepare('SELECT id,username FROM users WHERE username=? AND active=1').bind(name).first();
  return await db.prepare("SELECT id,username FROM users WHERE role='admin' AND active=1 ORDER BY id ASC LIMIT 1").first();
}
async function getBotControl(db, uid) {
  let r = await db.prepare('SELECT * FROM bot_control WHERE user_id=?').bind(uid).first();
  if (!r) {
    await db.prepare('INSERT INTO bot_control (user_id,enabled,daily_max_loss) VALUES (?,0,0)').bind(uid).run();
    r = await db.prepare('SELECT * FROM bot_control WHERE user_id=?').bind(uid).first();
  }
  return r;
}
async function dayPnl(db, uid) {
  const d = new Date(); d.setUTCHours(0, 0, 0, 0);
  const ss = await db.prepare('SELECT * FROM sessions WHERE user_id=? AND started_at>=?').bind(uid, d.toISOString()).all();
  let total = 0;
  for (const s of (ss.results || [])) {
    let end = s.end_capital;
    if (end == null) {
      const t = await db.prepare('SELECT capital_after FROM trades WHERE session_id=? ORDER BY seq DESC LIMIT 1').bind(s.id).first();
      end = t ? t.capital_after : s.start_capital;
    }
    total += Number(end) - Number(s.start_capital);
  }
  return total;
}
