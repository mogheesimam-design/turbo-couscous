let ready = false;

async function schema(db) {
  if (ready) return;
  await db.batch([
    db.prepare("CREATE TABLE IF NOT EXISTS settings (id INTEGER PRIMARY KEY CHECK (id=1), model TEXT NOT NULL DEFAULT 'tatura', total_capital REAL NOT NULL DEFAULT 1000, base_stake_pct REAL NOT NULL DEFAULT 8, total_trades INTEGER NOT NULL DEFAULT 5, expected_wins INTEGER NOT NULL DEFAULT 3, loss_limit INTEGER NOT NULL DEFAULT 3, payout_pct REAL NOT NULL DEFAULT 80, target_profit_pct REAL NOT NULL DEFAULT 30, max_stake_pct REAL NOT NULL DEFAULT 100, ladder TEXT NOT NULL DEFAULT '[7,12,18,26,36,48]')"),
    db.prepare("CREATE TABLE IF NOT EXISTS sessions (id INTEGER PRIMARY KEY AUTOINCREMENT, started_at TEXT NOT NULL, ended_at TEXT, model TEXT NOT NULL DEFAULT 'tatura', start_capital REAL NOT NULL, end_capital REAL, base_stake_pct REAL NOT NULL DEFAULT 8, total_trades INTEGER NOT NULL, expected_wins INTEGER NOT NULL, loss_limit INTEGER NOT NULL DEFAULT 3, payout_pct REAL NOT NULL, target_profit_pct REAL NOT NULL DEFAULT 30, max_stake_pct REAL NOT NULL DEFAULT 100, ladder TEXT NOT NULL, wins INTEGER NOT NULL DEFAULT 0, losses INTEGER NOT NULL DEFAULT 0, status TEXT NOT NULL DEFAULT 'active', note TEXT)"),
    db.prepare("CREATE TABLE IF NOT EXISTS trades (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id INTEGER NOT NULL, seq INTEGER NOT NULL, stake_pct REAL NOT NULL, stake_amount REAL NOT NULL, result TEXT NOT NULL, capital_after REAL NOT NULL, created_at TEXT NOT NULL)"),
    db.prepare("CREATE INDEX IF NOT EXISTS idx_trades_session ON trades(session_id)"),
    db.prepare("CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT NOT NULL UNIQUE, pass_hash TEXT NOT NULL, salt TEXT NOT NULL, role TEXT NOT NULL DEFAULT 'user', display_name TEXT, active INTEGER NOT NULL DEFAULT 1, created_at TEXT NOT NULL)"),
    db.prepare("CREATE TABLE IF NOT EXISTS auth_tokens (token TEXT PRIMARY KEY, user_id INTEGER NOT NULL, created_at TEXT NOT NULL, expires_at TEXT NOT NULL)"),
        db.prepare("CREATE INDEX IF NOT EXISTS idx_tokens_user ON auth_tokens(user_id)"),
    db.prepare("CREATE TABLE IF NOT EXISTS bot_control (user_id INTEGER PRIMARY KEY, enabled INTEGER NOT NULL DEFAULT 0, daily_max_loss REAL NOT NULL DEFAULT 0, last_seen TEXT, last_note TEXT)")
  ]);
  const sInfo = await db.prepare("PRAGMA table_info(settings)").all();
  const sHasUser = (sInfo.results || []).some(function (c) { return c.name === 'user_id'; });
  if (!sHasUser) {
    await db.batch([
      db.prepare("CREATE TABLE settings_new (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER UNIQUE, model TEXT NOT NULL DEFAULT 'tatura', total_capital REAL NOT NULL DEFAULT 1000, base_stake_pct REAL NOT NULL DEFAULT 8, total_trades INTEGER NOT NULL DEFAULT 5, expected_wins INTEGER NOT NULL DEFAULT 3, loss_limit INTEGER NOT NULL DEFAULT 3, payout_pct REAL NOT NULL DEFAULT 80, target_profit_pct REAL NOT NULL DEFAULT 30, max_stake_pct REAL NOT NULL DEFAULT 100, ladder TEXT NOT NULL DEFAULT '[7,12,18,26,36,48]')"),
      db.prepare("INSERT INTO settings_new (user_id,model,total_capital,base_stake_pct,total_trades,expected_wins,loss_limit,payout_pct,target_profit_pct,max_stake_pct,ladder) SELECT 1,model,total_capital,base_stake_pct,total_trades,expected_wins,loss_limit,payout_pct,target_profit_pct,max_stake_pct,ladder FROM settings"),
      db.prepare("DROP TABLE settings"),
      db.prepare("ALTER TABLE settings_new RENAME TO settings")
    ]);
  }
  const tInfo = await db.prepare("PRAGMA table_info(sessions)").all();
  const tHasUser = (tInfo.results || []).some(function (c) { return c.name === 'user_id'; });
  if (!tHasUser) {
    await db.batch([
      db.prepare("ALTER TABLE sessions ADD COLUMN user_id INTEGER"),
      db.prepare("UPDATE sessions SET user_id=1 WHERE user_id IS NULL"),
      db.prepare("CREATE INDEX IF NOT EXISTS idx_sessions_user ON sessions(user_id)")
    ]);
  }
  ready = true;
}

const ENC = new TextEncoder();
function b64(buf) { let out = ''; const b = new Uint8Array(buf); for (let i = 0; i < b.length; i++) out += String.fromCharCode(b[i]); return btoa(out); }
async function hashPass(pw, salt) {
  const key = await crypto.subtle.importKey('raw', ENC.encode(pw), { name: 'PBKDF2' }, false, ['deriveBits']);
  const bits = await crypto.subtle.deriveBits({ name: 'PBKDF2', salt: ENC.encode(salt), iterations: 100000, hash: 'SHA-256' }, key, 256);
  return b64(bits);
}
