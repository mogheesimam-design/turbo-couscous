.tr .p{flex:1;font-variant-numeric:tabular-nums}
.tag{font-size:9.5px;font-weight:800;letter-spacing:.1em;padding:4px 9px;border-radius:7px;text-transform:uppercase}
.tag.win{background:rgba(34,197,94,.14);color:#5ee08f;border:1px solid rgba(34,197,94,.3)}
.tag.loss{background:rgba(240,82,82,.14);color:#ff8b8b;border:1px solid rgba(240,82,82,.3)}
.tag.open{background:rgba(245,196,81,.14);color:var(--gold);border:1px solid rgba(245,196,81,.3)}
.x{background:0;border:0;color:var(--dim);font-size:16px;cursor:pointer;padding:4px 8px;border-radius:8px;transition:.15s}
.x:hover{color:var(--red);background:rgba(240,82,82,.1)}
